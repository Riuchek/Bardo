# GraphQL schema example
#
# https://gqlgen.com/getting-started/

type Story {
  title: String!
  content: String!
  year: Int!
}

type Todo {
  id: ID!
  text: String!
  done: Boolean!
}

input NewTodo {
  text: String!
}

type Query {
 bardoTale: Story!
}


type Mutation {
  createTodo(input: NewTodo!): Todo!
}
